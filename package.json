{
  "name": "orbi-condo-pc2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:private-boundaries": "node scripts/test-private-boundaries.mjs",
    "test:continuity": "node --experimental-strip-types scripts/test-continuity-model.mjs",
    "test:operations-domain": "node --experimental-strip-types scripts/test-operations-domain.mjs",
    "test:build-clean": "git diff --exit-code -- tsconfig.json next-env.d.ts",
    "test:auth-hermetic": "node scripts/test-auth-lifecycle-hermetic.mjs",
    "test:anonymous-security": "node scripts/test-anonymous-security-smoke.mjs",
    "check": "npm run typecheck && npm run test:private-boundaries && npm run test:continuity && npm run test:operations-domain && npm run build && npm run test:build-clean && npm run test:auth-hermetic && npm run test:anonymous-security",
    "qa:operations": "node scripts/qa-private-operations.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
